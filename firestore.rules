rules_version = '2';
// 콘텐츠 갭 로그: 누구나 "쓰기"만 가능(형식 검사), 읽기·수정·삭제는 막음 → 운영자는 Firebase 콘솔에서 확인
service cloud.firestore {
  match /databases/{database}/documents {
    match /content_gaps/{id} {
      allow create: if request.resource.data.keys().hasOnly(['q', 'page', 'createdAt'])
        && request.resource.data.q is string
        && request.resource.data.q.size() > 0
        && request.resource.data.q.size() <= 300
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
